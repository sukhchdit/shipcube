{
  "$description": "Platform design tokens v1.0 (P2 UX, 2026-11-12). Format: W3C Design Tokens Community Group draft ($type/$value, {alias} references). Dimensions are CSS strings for Style Dictionary v4 / Tailwind compatibility. Source of truth for packages/ui; the CSS-variable name of a token is --<path joined by '-'> (e.g. space.2 -> --space-2, theme.light.text.primary -> --color-text-primary under [data-theme=light]).",
  "$extensions": {
    "com.platform.meta": {
      "version": "1.0.0",
      "owner": "ux-designer",
      "brief": "shipping-platform-brief.md section 8",
      "cssVariablePrefixRules": {
        "theme.<mode>.<group>.<name>": "--color-<group>-<name> (scoped to :root[data-theme=<mode>] and @media (prefers-color-scheme) when data-theme=system)",
        "space.<n>": "--space-<n>",
        "radius.<n>": "--radius-<n>",
        "font.size.<n>": "--font-size-<n>",
        "font.lineHeight.<n>": "--line-height-<n>",
        "shadow.<mode>.<n>": "--shadow-<n>",
        "motion.duration.<n>": "--duration-<n>",
        "motion.easing.<n>": "--ease-<n>",
        "size.<group>.<n>": "--size-<group>-<n>",
        "zIndex.<n>": "--z-<n>"
      },
      "tenantOverridable": [
        "theme.light.action.primary.bg",
        "theme.light.action.primary.bgHover",
        "theme.light.action.primary.bgActive",
        "theme.light.action.primary.fg",
        "theme.light.text.link",
        "theme.light.focus.ring",
        "theme.light.border.selected",
        "theme.light.bg.selected",
        "theme.dark.action.primary.bg",
        "theme.dark.action.primary.bgHover",
        "theme.dark.action.primary.bgActive",
        "theme.dark.action.primary.fg",
        "theme.dark.text.link",
        "theme.dark.focus.ring",
        "theme.dark.border.selected",
        "theme.dark.bg.selected"
      ],
      "tenantOverrideRule": "Overrides come from tenant branding configuration (BRAND_* for the operator; per-tenant config later). Every override is run through the same contrastPairs test at build time (operator) or at load time (tenant). A failing pair rejects the override for that theme, logs a warning naming the pair, and the default token is used. Never ship an override that fails a pair."
    },
    "com.platform.contrastPairs": {
