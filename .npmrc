# Supply-chain hardening (ADR-0023 amendment F, SEC-P3-04). Committed and copied into
# every image stage. Lifecycle scripts never run on install; the allow-listed
# post-install work is `npm run deps:rebuild` (tools/deps/rebuild.mjs).
ignore-scripts=true
engine-strict=true
save-exact=true
fund=false
update-notifier=false
# `npm audit` runs as an explicit step (ADR-0002 §1), not on every install.
audit=false
# Release cooldown, defence in depth for the lane A age check (npm >= 11.10; SPK-01).
min-release-age=7
# Workspace packages are never fetched from a registry: the `@platform` scope on npmjs.com belongs
# to a third party (PR1-SEC-01, dependency confusion). `.invalid` never resolves (RFC 6761), so any
# registry lookup of `@platform/*` fails closed instead of querying the public registry.
@platform:registry=https://registry.invalid/
