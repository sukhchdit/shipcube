# Configuration reference (ADR-0018, NFR-OPS-005). PLACEHOLDERS ONLY: never put a real value in this file.
#
# Every key of the packages/config schemas (API/worker: packages/config/src/schema.ts; web build:
# packages/config/src/web/web-schema.ts) appears here exactly once; tools/config/env-example-parity.test.ts fails
# on drift. Secrets show CHANGE_ME; start-up refuses placeholder and local-only-* values when
# APP_ENV is staging or production (SEC-TC-51). Local defaults that work with Docker Compose live in compose.env.
# Carrier-sandbox and Stripe test credentials go only in user-scoped environment variables or the git-ignored
# .env.local (platform.md §2.7), never in this file or compose.env.
#
# Formats
#   Key variables      <key_id>:<base64>, key_id = <purpose>-v<n>; optional <NAME>_PREVIOUS holds the retired key.
#   Key sets           comma-separated <key_id>:<base64> entries (JWT: PKCS#8 DER, first entry signs).
#   Secret references  env:<VARIABLE> | <VARIABLE> | file:/run/secrets/<name> | aws-secrets-manager:<arn-or-name>
#                      e.g. STRIPE_SECRET_KEY_REF=env:STRIPE_SECRET_KEY reads the value from STRIPE_SECRET_KEY.
#   Durations          <n><s|m|h|d>, e.g. 30d.

# --- Process and application ------------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=local
APP_PORT=3000
APP_HEALTH_PORT=9464
APP_LOG_LEVEL=info
DOCS_ENABLED=true
WEB_APP_ORIGIN=https://localhost:8443
ADMIN_APP_ORIGIN=https://localhost:8444
TRUST_PROXY_HOPS=1
REGION=local
LOCALE_DEFAULT=en
FEATURE_FLAGS_DEFAULTS_PATH=

# --- Debug guards: must stay unset outside APP_ENV=local (SEC-P3-08 item 6) ---------------------------------
NODE_DEBUG=
DEBUG=
NODE_OPTIONS=

# --- Brand (shared by API, worker and web builds) ---------------------------------------------------------
BRAND_NAME=Shipqube
BRAND_LOGO_URL=
BRAND_LOGO_DARK_URL=
BRAND_FAVICON_URL=

# --- Web and admin build (public values only) -------------------------------------------------------------
VITE_API_BASE_URL=/api
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_LOCALES=en,es,fr
VITE_FEATURE_FLAGS_ENDPOINT=

# --- Database (sslmode=verify-full outside local/test) ----------------------------------------------------
DATABASE_URL=postgresql://platform_app:CHANGE_ME@localhost:5432/platform?sslmode=disable
DATABASE_MIGRATOR_URL=postgresql://platform_migrator:CHANGE_ME@localhost:5432/platform?sslmode=disable
SHADOW_DATABASE_URL=postgresql://platform_migrator:CHANGE_ME@localhost:5432/platform_shadow?sslmode=disable
DB_POOL_MAX=10

# --- Valkey (one ACL user per service; rediss:// outside local/test) --------------------------------------
REDIS_URL=redis://api:CHANGE_ME@localhost:6379

# --- Identity and sessions --------------------------------------------------------------------------------
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TTL=30d
AUTH_SESSION_ABSOLUTE_TTL=30d
AUTH_ADMIN_REFRESH_IDLE_TTL=30m
AUTH_ADMIN_SESSION_ABSOLUTE_TTL=12h
AUTH_UNVERIFIED_TTL=7d
AUTH_BCRYPT_COST=12
AUTH_HASH_WORKERS=2

# --- Key register (ADR-0018 amendment item 1) -------------------------------------------------------------
JWT_SIGNING_KEYS=jwt-signing-v1:CHANGE_ME
CSRF_KEY=csrf-v1:CHANGE_ME
CSRF_KEY_PREVIOUS=
RECOVERY_KEY=recovery-v1:CHANGE_ME
RECOVERY_KEY_PREVIOUS=
MFA_ENCRYPTION_KEY=mfa-v1:CHANGE_ME
MFA_ENCRYPTION_KEY_PREVIOUS=
AUDIT_VAULT_KEY=vault-v1:CHANGE_ME
AUDIT_VAULT_KEY_PREVIOUS=
AUDIT_INDEX_KEY=audit-index-v1:CHANGE_ME
AUDIT_INDEX_KEY_PREVIOUS=
AUDIT_ANCHOR_SIGNING_KEY=audit-anchor-v1:CHANGE_ME
AUDIT_ANCHOR_PUBLIC_KEYS=
TRACKING_INDEX_KEY=tracking-index-v1:CHANGE_ME
TRACKING_INDEX_KEY_PREVIOUS=
OUTBOX_PAYLOAD_KEY=outbox-payload-v1:CHANGE_ME
OUTBOX_PAYLOAD_KEY_PREVIOUS=
IDEMPOTENCY_BODY_KEY=idempotency-body-v1:CHANGE_ME
IDEMPOTENCY_BODY_KEY_PREVIOUS=
CURSOR_KEY=cursor-v1:CHANGE_ME
CURSOR_KEY_PREVIOUS=
LOGIN_COUNTER_KEY=login-counter-v1:CHANGE_ME
CARRIER_TOKEN_CACHE_KEY=carrier-token-cache-v1:CHANGE_ME
CARRIER_TOKEN_CACHE_KEY_PREVIOUS=
IDENTIFIER_ENCRYPTION_KEY=identifier-v1:CHANGE_ME
IDENTIFIER_ENCRYPTION_KEY_PREVIOUS=
AUDIT_VAULT_HMAC_KEY=vault-hmac-v1:CHANGE_ME
AUDIT_VAULT_HMAC_KEY_PREVIOUS=
MFA_CHALLENGE_BIND_KEY=mfa-challenge-bind-v1:CHANGE_ME
MFA_ENROLMENT_CODE_KEY=mfa-enrolment-code-v1:CHANGE_ME
PASSWORD_PEPPER=pepper-v1:CHANGE_ME
PASSWORD_PEPPER_PREVIOUS=
MOCK_GATEWAY_WEBHOOK_SECRET=mock-gateway-webhook-v1:CHANGE_ME

# --- Payments (Mock below production; Stripe test mode only until G4) -------------------------------------
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY_REF=CHANGE_ME
STRIPE_WEBHOOK_SECRET_REF=CHANGE_ME
PAYMENT_ALLOW_FULL_TEST_KEY=false

# --- Carriers (Mock until sandbox credentials are supplied; sandbox only until G4) ------------------------
MOCK_CARRIER_ENABLED=true
MOCK_SCENARIOS_ENABLED=true
CARRIER_TOKEN_CACHE=redis
CARRIER_DHL_ENABLED=false
CARRIER_DHL_ENVIRONMENT=sandbox
CARRIER_DHL_SECRET_REF=CHANGE_ME
CARRIER_FEDEX_ENABLED=false
CARRIER_FEDEX_ENVIRONMENT=sandbox
CARRIER_FEDEX_SECRET_REF=CHANGE_ME
CARRIER_UPS_ENABLED=false
CARRIER_UPS_ENVIRONMENT=sandbox
CARRIER_UPS_SECRET_REF=CHANGE_ME

# --- Object storage (S3-compatible; IAM task role at M5) --------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true
STORAGE_BUCKET_DOCUMENTS=documents
STORAGE_BUCKET_RAW_CARRIER_PAYLOADS=raw-carrier-payloads
STORAGE_PRESIGN_TTL_SECONDS=300
STORAGE_ACCESS_KEY_ID_REF=CHANGE_ME
STORAGE_SECRET_ACCESS_KEY_REF=CHANGE_ME

# --- Mail -------------------------------------------------------------------------------------------------
MAIL_PROVIDER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_FROM=no-reply@shipqube.local
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD_REF=CHANGE_ME

# --- Telemetry --------------------------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Audit ------------------------------------------------------------------------------------------------
AUDIT_ANCHOR_SINK=file:///data/audit-anchors/anchors.ndjson

# --- Demo seed (local only) -------------------------------------------------------------------------------
SEED_SUPERADMIN_PASSWORD=CHANGE_ME
SEED_CUSTOMER_PASSWORD=CHANGE_ME

# --- database pool timeouts (runtime; defaults equal the TASK-003 pool factory) ---
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000

# --- tooling only (db:bootstrap / db:reset; never api/worker) ---
# DATABASE_MIGRATOR_URL and SHADOW_DATABASE_URL above are tooling keys too. Set a password or its _FILE path, not both.
DATABASE_BOOTSTRAP_URL=postgresql://postgres:CHANGE_ME@localhost:5432/postgres?sslmode=disable
BOOTSTRAP_MIGRATOR_PASSWORD=CHANGE_ME
BOOTSTRAP_MIGRATOR_PASSWORD_FILE=
BOOTSTRAP_APP_PASSWORD=CHANGE_ME
BOOTSTRAP_APP_PASSWORD_FILE=

# pg statement_timeout backstop of pooled connections, ms (TASK-006; PR-0005 m7)
DB_STATEMENT_TIMEOUT_MS=25000

# Per-transaction timeouts (ms) that withTenantTx sets transaction-locally (data-model 4.1; ADR-0005 am. 10 item 12).
DB_TX_STATEMENT_TIMEOUT_MS=5000
DB_TX_LOCK_TIMEOUT_MS=2000
DB_TX_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000

# Per-tenant admission bulkhead of withTenantTx (D-ARCH-086, data-model 7.7): concurrent tenant transactions per
# organisation per process (<= DB_POOL_MAX; empty = max(2, DB_POOL_MAX / 2)) and the admission wait (<= 2000 ms).
DB_TENANT_MAX_CONCURRENT_TX=
DB_TENANT_ADMISSION_WAIT_MS=250
# Transaction-local lock_timeout of the audit insert (ms); must be below DB_TX_LOCK_TIMEOUT_MS.
DB_AUDIT_LOCK_TIMEOUT_MS=250
