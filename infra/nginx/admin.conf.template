# Nginx server for apps/admin (platform.md §3.3, ADR-0026 §1 and amendment 5). TASK-004 scaffold.
#
# Template for the nginx image's envsubst step (/etc/nginx/templates/*.template -> /etc/nginx/conf.d/*.conf). The
# only placeholder is ${NGINX_PORT} (8080 in nginx-unprivileged). The image substitutes defined environment variables
# only, so the nginx runtime variables below ($uri, ...) pass through unchanged. No secrets.
#
# The admin app is a pure SPA (REQ-ADMIN-001): the document root holds `apps/admin/build/client/`, i.e. the SPA
# fallback /index.html (root HydrateFallback only) and the content-hashed /assets/*. Every route, `/` included, is
# served index.html with status 200 and resolved on the client; nothing is pre-rendered and nothing is indexed.
#
# Security headers and CSP: the hash-based CSP (`csp.conf`, generated from the built HTML) and the remaining
# REQ-SEC-001/002/003 headers (HSTS toggle, Permissions-Policy) are added by TASK-022 after SPK-06; the image
# Dockerfile is TASK-014 and the header/response test suite is TASK-111 (US-043). The static headers below need no
# build input. All add_header directives live at server level: a location-level add_header would drop every inherited
# one.

# Cache policy by path (NFR-WEB-005): hashed assets are immutable; HTML and robots.txt are revalidated. Keyed on the
# status too, so a 404 for a missing asset is not cached as immutable.
map "$status:$uri" $admin_cache_control {
    default              "no-cache";
    "~^200:/assets/"     "public, max-age=31536000, immutable";
}

server {
    # default_server: this block answers every request even if the image still carries the stock conf.d/default.conf
    # (PR4-SEC-02); TASK-014 removes that file.
    listen ${NGINX_PORT} default_server;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    absolute_redirect off;
    client_max_body_size 1k;
    # Pre-built *.gz files are served as is (gzip_static, produced by TASK-022); everything else compressible is
    # compressed on the fly (NFR-WEB-005). text/html is always compressed by gzip_types' implicit default.
    gzip_static on;
    gzip on;
    gzip_vary on;
    gzip_types text/css application/javascript text/javascript application/json image/svg+xml text/plain;
    charset utf-8;

    add_header Cache-Control $admin_cache_control always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    # Static site: only GET and HEAD (platform.md §3.3).
    if ($request_method !~ ^(?:GET|HEAD)$) {
        return 405;
    }

    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    # ADR-0026 amendment 5: the operator console is never crawled.
    location = /robots.txt {
        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    # Dotfiles are never served.
    location ~ /\. {
        deny all;
    }

    # A missing hashed asset is a real 404, never the HTML fallback.
    location /assets/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
    }
}
