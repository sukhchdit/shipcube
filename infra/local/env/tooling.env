# LOCAL-ONLY, NOT SECRET (platform.md §1, D-022). The migrate and seed one-shots only (TASK-014, PR13-SEC-08):
# DATABASE_MIGRATOR_URL appears in no other service. The seed refuses NODE_ENV=production with a local/test APP_ENV
# (D-TASK023-01 (02)), so both are set here (the tooling image defaults to NODE_ENV=production).

NODE_ENV=development
APP_ENV=local
DATABASE_MIGRATOR_URL=postgresql://platform_migrator:local-only-platform-migrator-password@postgres:5432/platform?sslmode=disable
