# LOCAL-ONLY, NOT SECRET (platform.md §1, §2.2 rustfs paragraph; D-ARCH-100 item 2). The rustfs and storage-init
# services only: the RustFS root credentials. They are the values that compose.env STORAGE_ACCESS_KEY_ID_REF and
# STORAGE_SECRET_ACCESS_KEY_REF resolve to (tools/compose/compose-stack.test.ts compares them).

RUSTFS_ACCESS_KEY=local-only-rustfs-access-key
RUSTFS_SECRET_KEY=local-only-rustfs-secret-key
