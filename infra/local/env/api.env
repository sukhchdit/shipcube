# LOCAL-ONLY, NOT SECRET (platform.md §1, D-022). The api service only, on top of compose.env (TASK-014,
# PR13-SEC-08/-06, PR3-SEC-06): its Valkey ACL user and the keys the ADR-0018 register gives to the api alone.
# The private JWT signing key lives here and never in the worker. Checked by tools/config/compose-env.test.ts.

REDIS_URL=redis://api:local-only-valkey-api-password@redis:6379

JWT_SIGNING_KEYS=jwt-signing-v1:local-only-jwt-signing-key
CSRF_KEY=csrf-v1:local-only-csrf-key
RECOVERY_KEY=recovery-v1:local-only-recovery-key
MFA_ENCRYPTION_KEY=mfa-v1:local-only-mfa-encryption-key
IDEMPOTENCY_BODY_KEY=idempotency-body-v1:local-only-idempotency-body-key
CURSOR_KEY=cursor-v1:local-only-cursor-key
LOGIN_COUNTER_KEY=login-counter-v1:local-only-login-counter-key
MFA_CHALLENGE_BIND_KEY=mfa-challenge-bind-v1:local-only-mfa-challenge-bind-key
MFA_ENROLMENT_CODE_KEY=mfa-enrolment-code-v1:local-only-mfa-enrolment-code-key
MOCK_GATEWAY_WEBHOOK_SECRET=mock-gateway-webhook-v1:local-only-mock-gateway-webhook-secret
