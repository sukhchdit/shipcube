# LOCAL-ONLY, NOT SECRET (platform.md §1, D-022). The bootstrap one-shot only (TASK-014, PR13-SEC-08/-06): the
# cluster-admin URL and the role passwords appear in no other service. The bootstrap runs on current_database(), so
# the URL names the platform database (postgres.env POSTGRES_DB). The role passwords equal the passwords in
# compose.env DATABASE_URL and tooling.env DATABASE_MIGRATOR_URL (tools/config/compose-env.test.ts).

APP_ENV=local
DATABASE_BOOTSTRAP_URL=postgresql://postgres:local-only-postgres-superuser-password@postgres:5432/platform?sslmode=disable
BOOTSTRAP_MIGRATOR_PASSWORD=local-only-platform-migrator-password
BOOTSTRAP_APP_PASSWORD=local-only-platform-app-password
