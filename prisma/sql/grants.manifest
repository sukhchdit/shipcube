# Grant manifest (data-model.md §4.4 grant matrix; catalog test C5; PR8-SEC-10, D-ARCH-069; TASK-016).
#
# Every table and column privilege held by a platform runtime role (platform_app, platform_definer, platform_erasure),
# one line per grant. Catalog test C5 (prisma/tests/catalog/c01-c12.int.test.ts) compares the live ACLs of every
# relation in public and platform with this file in both directions, so a grant in a migration or bootstrap file
# without its line here (or a line without its grant) fails. Parser: tools/db/grants-manifest.ts.
#
# Line format:  <grantee> <privilege> <schema>.<table>
#               <grantee> <privilege> <schema>.<table> (<column>, <column>, ...)    column grant
# Privileges:   SELECT | INSERT | UPDATE | DELETE (TRUNCATE, REFERENCES and TRIGGER are never granted at runtime).
# DELETE:       platform_app only on the SYSTEM hard-delete allow-list (table-class flag hardDelete); platform_definer
#               only on definerPurge tables; SELECT for platform_definer only on definerRead tables.

# authz catalogue (TASK-013, migration 20261112010000_authz_catalogue_tables): GLOBAL, read-only at runtime.
platform_app SELECT public.permissions
platform_app SELECT public.role_permissions
platform_app SELECT public.roles

# seed idempotency (TASK-023, migration 20261112030000_reference_dataset_versions): SYSTEM, SELECT only; the seed as
# platform_migrator (owner) is the single writer (data-model §3.5, §4.4; PR13-SEC-04, D-ARCH-075).
platform_app SELECT public.reference_dataset_versions

# HTTP idempotency keys (TASK-040, migration 20261120100000_idempotency_keys; data-model §3.5, §4.4, §6.2): SYSTEM,
# module idempotency, hard-delete allow-list. UPDATE for the lease takeover and the completion; DELETE for the release
# of a 5xx/429 or failed outcome, an expired key before it is claimed again, and the purge of expired rows.
platform_app SELECT public.idempotency_keys
platform_app INSERT public.idempotency_keys
platform_app UPDATE public.idempotency_keys
platform_app DELETE public.idempotency_keys

# pricing configuration versions (TASK-080, migration 20261121000000_pricing_config_versions): GLOBAL, SELECT only; the
# reference seed as platform_migrator (owner) is the single writer (data-model §3.9, §9.1; insert-only dataset).
platform_app SELECT public.pricing_config_versions

# job idempotency ledger (TASK-039, migration 20261119000000_job_executions): SYSTEM, module worker; insert-only.
platform_app SELECT public.job_executions
platform_app INSERT public.job_executions

# audit store (TASK-021, bootstrap lane prisma/bootstrap/10-audit.sql; data-model §4.4 grant matrix, C5): SYSTEM.
# Append-only tables exactly SELECT, INSERT; audit_entries on the parent only, never on a partition (partitions carry
# zero privileges). Mutable SYSTEM tables SELECT, INSERT, UPDATE. Never DELETE/TRUNCATE for platform_app.
platform_app SELECT public.audit_entries
platform_app INSERT public.audit_entries
platform_app SELECT public.audit_checkpoint_heads
platform_app INSERT public.audit_checkpoint_heads
platform_app SELECT public.audit_anchors
platform_app INSERT public.audit_anchors
platform_app SELECT public.audit_pii_vault
platform_app INSERT public.audit_pii_vault
platform_app SELECT public.data_subjects
platform_app INSERT public.data_subjects
platform_app SELECT public.audit_stream_heads
platform_app INSERT public.audit_stream_heads
platform_app UPDATE public.audit_stream_heads
platform_app SELECT public.audit_partitions
platform_app INSERT public.audit_partitions
platform_app UPDATE public.audit_partitions
platform_app SELECT public.audit_chain_verifications
platform_app INSERT public.audit_chain_verifications
platform_app UPDATE public.audit_chain_verifications
# erasure role (M4/M5 erasure job, OI-15): vault hard delete (admitted by audit_vault_guard only with an erasure
# request id) and the data_subjects erasure marker.
platform_erasure SELECT public.audit_pii_vault
platform_erasure DELETE public.audit_pii_vault
platform_erasure SELECT public.data_subjects
platform_erasure UPDATE public.data_subjects (erased_at, updated_at, updated_by, version)

# organisations and users (TASK-037, migration 20261117000000_organisations_identity; data-model §3.1, §3.2, §4.4):
# RLS tables, SELECT/INSERT/UPDATE for platform_app (never DELETE: soft delete and status history); SELECT for
# platform_definer on the definerRead tables (the §4.5 functions and platform.app_is_operator()).
platform_app SELECT public.users
platform_app INSERT public.users
platform_app UPDATE public.users
platform_app SELECT public.organisations
platform_app INSERT public.organisations
platform_app UPDATE public.organisations
platform_app SELECT public.memberships
platform_app INSERT public.memberships
platform_app UPDATE public.memberships
platform_app SELECT public.membership_roles
platform_app INSERT public.membership_roles
platform_app UPDATE public.membership_roles
platform_app SELECT public.invitations
platform_app INSERT public.invitations
platform_app UPDATE public.invitations
platform_definer SELECT public.users
platform_definer SELECT public.organisations
platform_definer SELECT public.memberships
platform_definer SELECT public.invitations
