// Platform module (data-model.md §3.5). SYSTEM tables: no RLS (`outbox_events.org_id` is informational for the relay and
// authoritative for platform.job_context). Grants per table in prisma/sql/grants.manifest.
//
// Not expressible in Prisma and kept in the migration SQL: CHECK constraints (`ck_reference_dataset_versions__version`,
// `ck_reference_dataset_versions__content_sha256` = 32 bytes, `ck_reference_dataset_versions__row_count` >= 0).

/// Seed idempotency (REQ-DATA-001, REQ-COMP-008): one row per seeded dataset with the SHA-256 of its canonical content.
/// The row-level `version` is the standard optimistic-lock column; the dataset's own version label is `datasetVersion`.
model ReferenceDatasetVersion {
  id             String   @id(map: "pk_reference_dataset_versions") @default(dbgenerated("uuidv7()")) @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy      String   @map("created_by") @db.Uuid
  updatedBy      String   @map("updated_by") @db.Uuid
  version        Int      @default(1)
  dataset        String
  datasetVersion String   @map("dataset_version")
  contentSha256  Bytes    @map("content_sha256")
  appliedAt      DateTime @map("applied_at") @db.Timestamptz(6)
  rowCount       Int      @map("row_count")

  @@unique([dataset], map: "ux_reference_dataset_versions__dataset")
  @@map("reference_dataset_versions")
}

/// Idempotency ledger of job effects (ADR-0013 §4, REQ-PLAT-014; data-model §3.5, D-ARCH-171). SYSTEM class, module `worker`
/// (tools/db/table-classes/worker.json): reached only through the worker's SYSTEM accessor. One row per completed job,
/// inserted in the effect's transaction (`createMany` with `skipDuplicates`), never updated. Kept in the migration SQL:
/// `ck_job_executions__version`, `__job_key` (1..200 chars), `__queue` (kebab name), `__status` ('completed'),
/// `__result_unset` (reserved column, PR039-SEC-05) and the
/// standard-columns guard trigger.
model JobExecution {
  id          String   @id(map: "pk_job_executions") @default(dbgenerated("uuidv7()")) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy   String   @map("created_by") @db.Uuid
  updatedBy   String   @map("updated_by") @db.Uuid
  version     Int      @default(1)
  jobKey      String   @map("job_key")
  queue       String
  status      String   @default("completed")
  result      Json?
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)

  @@unique([queue, jobKey], map: "ux_job_executions__queue_job_key")
  @@index([completedAt], map: "ix_job_executions__completed_at")
  @@map("job_executions")
}

/// Transactional outbox (ADR-0004; REQ-PLAT-016/017; data-model §3.5, §6.1; TASK-043). SYSTEM class, module `outbox`
/// (tools/db/table-classes/outbox.json): written by apps/api/src/platform/outbox/writer.ts inside the business
/// transaction, relayed and purged by apps/worker/src/platform/outbox/**. Kept in the migration SQL: the partial indexes
/// `ix_outbox_events__unpublished` (relay batch, `WHERE published_at IS NULL`) and `ix_outbox_events__published_at`
/// (purge, `WHERE published_at IS NOT NULL`), the CHECKs `ck_outbox_events__version`, `__type`, `__aggregate_type`,
/// `__correlation_id`, `__attempts`, `__last_error`, the autovacuum settings and the standard-columns guard trigger.
model OutboxEvent {
  id            String    @id(map: "pk_outbox_events") @default(dbgenerated("uuidv7()")) @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid
  version       Int       @default(1)
  type          String
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  orgId         String?   @map("org_id") @db.Uuid
  actorId       String    @map("actor_id") @db.Uuid
  payload       Json
  correlationId String    @map("correlation_id")
  traceContext  String?   @map("trace_context")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")

  @@index([aggregateType, aggregateId, createdAt], map: "ix_outbox_events__aggregate")
  @@map("outbox_events")
}

/// Consumer dedupe of outbox events (ADR-0004 item 4; REQ-PLAT-017; data-model §3.5; TASK-043). SYSTEM class, module
/// `worker`: a consumer inserts `(consumer, event_id)` in its business transaction with ON CONFLICT DO NOTHING. Insert-only;
/// purged 30 days after `processed_at`. Kept in the migration SQL: `ck_processed_events__version`, `__consumer` and the
/// standard-columns guard trigger.
model ProcessedEvent {
  id          String   @id(map: "pk_processed_events") @default(dbgenerated("uuidv7()")) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy   String   @map("created_by") @db.Uuid
  updatedBy   String   @map("updated_by") @db.Uuid
  version     Int      @default(1)
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@unique([consumer, eventId], map: "ux_processed_events__consumer_event")
  @@index([processedAt], map: "ix_processed_events__processed_at")
  @@map("processed_events")
}
