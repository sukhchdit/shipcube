// Platform module (data-model.md §3.5). SYSTEM tables: no org_id, no RLS. `platform_app` holds SELECT, INSERT and UPDATE.
//
// Not expressible in Prisma and kept in the migration SQL: CHECK constraints (`ck_reference_dataset_versions__version`,
// `ck_reference_dataset_versions__content_sha256` = 32 bytes, `ck_reference_dataset_versions__row_count` >= 0).

/// Seed idempotency (REQ-DATA-001, REQ-COMP-008): one row per seeded dataset with the SHA-256 of its canonical content.
/// The row-level `version` is the standard optimistic-lock column; the dataset's own version label is `datasetVersion`.
model ReferenceDatasetVersion {
  id             String   @id(map: "pk_reference_dataset_versions") @default(dbgenerated("uuidv7()")) @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy      String   @map("created_by") @db.Uuid
  updatedBy      String   @map("updated_by") @db.Uuid
  version        Int      @default(1)
  dataset        String
  datasetVersion String   @map("dataset_version")
  contentSha256  Bytes    @map("content_sha256")
  appliedAt      DateTime @map("applied_at") @db.Timestamptz(6)
  rowCount       Int      @map("row_count")

  @@unique([dataset], map: "ux_reference_dataset_versions__dataset")
  @@map("reference_dataset_versions")
}

/// Idempotency ledger of job effects (ADR-0013 §4, REQ-PLAT-014; TASK-039). SYSTEM class, module `worker`
/// (tools/db/table-classes/worker.json): reached only through the worker's SYSTEM accessor. One row per completed job,
/// inserted in the effect's transaction (`createMany` with `skipDuplicates`), never updated. Kept in the migration SQL:
/// `ck_job_executions__version`, `__job_key` (1..200 chars), `__queue` (kebab name), `__status` ('completed') and the
/// standard-columns guard trigger.
model JobExecution {
  id          String   @id(map: "pk_job_executions") @default(dbgenerated("uuidv7()")) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy   String   @map("created_by") @db.Uuid
  updatedBy   String   @map("updated_by") @db.Uuid
  version     Int      @default(1)
  jobKey      String   @map("job_key")
  queue       String
  status      String   @default("completed")
  result      Json?
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)

  @@unique([jobKey], map: "ux_job_executions__job_key")
  @@map("job_executions")
}
