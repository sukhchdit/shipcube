// Base of the multi-file Prisma schema (ADR-0005, data-model.md §7.1-§7.2). One file per module joins this folder;
// prisma.config.ts points `schema` at the folder. The datasource URL lives in prisma.config.ts, never here.
//
// Generator: Prisma 7 `prisma-client` (engine-free, driver adapters). The output folder is git-ignored and is
// regenerated by `npm run deps:rebuild` (ADR-0023 am. F) or `npm run db:generate`, both through tools/deps/prisma-cli.mjs.
// The output is the composite project prisma/client/tsconfig.json, packaged as `@platform/prisma/client` (D-ARCH-102).
//
// The four emit options are pinned (D-ARCH-102 (1)): unpinned, the CLI infers the module format and the import
// extension from the nearest tsconfig.json, so a `module` or `moduleResolution` edit would silently change the emitted
// imports. tools/db/prisma-client-package.test.ts parses this block.

generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}
