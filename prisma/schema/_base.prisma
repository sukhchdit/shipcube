// Base of the multi-file Prisma schema (ADR-0005, data-model.md §7.1-§7.2). One file per module joins this folder;
// prisma.config.ts points `schema` at the folder. The datasource URL lives in prisma.config.ts, never here.
//
// Generator: Prisma 7 `prisma-client` (engine-free, driver adapters). The output folder is git-ignored and is
// regenerated by `npm run deps:rebuild` (ADR-0023 am. F) through tools/deps/prisma-cli.mjs.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
