{
  "name": "@platform/api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "HTTP API process of the modular monolith (ADR-0003).",
  "exports": {
    "./testing": {
      "@platform/source": "./src/platform/routing/tests/timing.ts",
      "types": "./dist/platform/routing/tests/timing.d.ts",
      "default": "./dist/platform/routing/tests/timing.js"
    },
    "./runtime": {
      "@platform/source": "./src/platform/runtime/index.ts",
      "types": "./dist/platform/runtime/index.d.ts",
      "default": "./dist/platform/runtime/index.js"
    },
    "./modules/*": {
      "@platform/source": "./src/modules/*/index.ts",
      "types": "./dist/modules/*/index.d.ts",
      "default": "./dist/modules/*/index.js"
    }
  },
  "scripts": {
    "build": "tsx ../../tools/api/gen-module-registry.ts && tsc -b"
  },
  "dependencies": {
    "@platform/shared": "0.0.0",
    "@platform/config": "0.0.0",
    "@platform/authz": "0.0.0",
    "@platform/audit": "0.0.0",
    "@platform/pricing": "0.0.0",
    "@platform/carriers": "0.0.0",
    "@platform/prisma": "0.0.0",
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/s3-request-presigner": "^3.1165.0",
    "@opentelemetry/sdk-node": "^0.301.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "^6.0.0",
    "bowser": "^2.15.0",
    "bullmq": "^6.7.2",
    "cookie": "^2.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "joi": "^18.3.2",
    "jose": "^6.2.17",
    "otplib": "^13.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.2",
    "stripe": "^23.1.0",
    "swagger-ui-dist": "^5.34.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1"
  }
}
