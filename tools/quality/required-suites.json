  "owner": "qa-lead",
  "canonical_location": "tools/quality/required-suites.json",
  "rules": {
    "verdict": "recomputed from attachments; declared verdict is informational; mismatch = FAIL",
    "presence": "every required suite present with tests >= max(min_tests, 1)",
    "failures": "failures + errors = 0 in every required suite",
    "junit_counts_equal_summary": true,
    "zero_skip": "suites with security=true or zero_skip=true must report skipped = 0",
    "required_cases": "every ID in required_cases appears in the name of at least one passing testcase of that suite; a skipped or failed testcase carrying a SEC-TC ID fails the check in any suite (required cases are zero-skip wherever they live)",
    "journeys_required_at_gate": "at profile 'gate' each listed journey ID appears in passing testcases of every project of the suite (6 projects across the three e2e suites); 0 flaky results in the gate run",
    "planned_suite_reported": "a run that holds a JUnit file for a suite whose status is 'planned' in the base manifest is rejected, i.e. not credited; that fails the check only when the change needed evidence. The PR that activates a suite passes with its own run uncredited; a later activation whose run also carries the newly activated suite is rejected as a whole",
    "gate_requires_all_active": "at profile 'gate' every suite must be 'active' unless listed in deferred_at_gate with a DECISIONS.md ID",
    "invalid_env_prefixes": ["SKIP_"],
    "recorded_env_prefixes": ["SKIP_", "TEST_"],
    "clean_tree_paths": ["apps/**", "packages/**", "prisma/**", "tools/**", "tests/**", "*.config.*", ".env*", "!.env.example", "compose*.yaml", "package*.json", ".npmrc"],
    "min_tests_policy": "ratchet: at each wave end qa-lead raises min_tests to the count of that wave's lane B 'wave' run (generated suites: exact cell count); lowering needs a DECISIONS.md entry",
    "report_naming": "<suite>.junit.xml in docs/05-quality/tests/runs/<UTCstamp>_<sha7>/; native JSON of non-Jest tools under security/ or performance/ runs with the same <UTCstamp>_<sha7>"
  },
