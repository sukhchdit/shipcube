    "zap-baseline": { "lane": ["B"], "runner": "OWASP ZAP baseline (docker) vs compose, rules file with reasons, converted to JUnit", "security": true, "zero_skip": true, "status": "planned", "activate_with": "T-QA-09", "min_tests": 1, "required_cases": [], "nfr": ["NFR-SEC-002", "NFR-SEC-006"] },
    "gitleaks-full": { "lane": ["B", "C"], "runner": "gitleaks detect over full history (container)", "security": true, "zero_skip": true, "status": "planned", "activate_with": "W0 CI", "min_tests": 1, "required_cases": [], "nfr": ["NFR-SEC-002"] },
    "stryker": { "lane": ["B"], "runner": "stryker run (packages/pricing), converted to JUnit", "security": false, "zero_skip": false, "status": "planned", "activate_with": "US-151", "min_tests": 1, "required_cases": [], "nfr": ["NFR-QUAL-003"] },
    "restore-rehearsal": { "lane": ["B", "C"], "runner": "tools/db backup + restore into a fresh stack + tools/db/verify-restore.ts", "security": false, "zero_skip": false, "status": "planned", "activate_with": "first data-changing migration or W1", "min_tests": 1, "required_cases": [], "nfr": ["NFR-REC-001", "NFR-REC-002", "NFR-REC-003", "NFR-DATA-004"] },
    "valkey-compat": { "lane": ["B"], "runner": "jest --selectProjects integration against Valkey and Redis OSS images", "security": false, "zero_skip": false, "status": "planned", "activate_with": "US-009", "min_tests": 1, "required_cases": [], "nfr": [] },
    "flake-report": { "lane": ["B"], "runner": "quality:flake-report over the last 20 e2e runs", "security": false, "zero_skip": false, "status": "planned", "activate_with": "T-QA-08", "min_tests": 1, "required_cases": [], "nfr": ["NFR-QUAL-006"], "report": "flake-report.json" },
    "ac-trace": { "lane": ["B"], "runner": "quality:trace", "security": false, "zero_skip": false, "status": "planned", "activate_with": "T-QA-02", "min_tests": 1, "required_cases": [], "nfr": [], "report": "ac-trace.json" },
    "contract-live": { "lane": ["opt-in"], "runner": "CARRIER_LIVE_SANDBOX=1 npm run test:contract:live", "security": false, "zero_skip": false, "status": "opt-in", "activate_with": "credentials supplied (D-003)", "min_tests": 0, "required_cases": [], "nfr": ["NFR-QUAL-005"], "gating": "never (COND-SANDBOX-DEMO)" },
    "e2e-live": { "lane": ["opt-in"], "runner": "CARRIER_LIVE_SANDBOX=1 STRIPE_TEST_LIVE=1 playwright --grep @live-sandbox", "security": false, "zero_skip": false, "status": "opt-in", "activate_with": "credentials supplied (D-003)", "min_tests": 0, "required_cases": [], "nfr": [], "gating": "never (COND-SANDBOX-DEMO)" }
  },
  "profiles": {
    "pr": {
      "description": "Minimum: the suites selected by path_rules for the PR's changed paths, plus the unit pre-flight.",
      "always": ["unit"]
    },
    "wave": {
      "description": "Every active lane B suite except the gate-only ones.",
      "always": ["unit", "integration", "catalog-c1-c14", "rls-cross-tenant", "rbac-matrix", "audit-generator", "audit-immutability", "audit-chain", "abuse", "api", "identity-session", "csrf-cookie", "rate-limit", "idempotency", "ssrf", "payments-webhooks", "saga-fault-matrix", "carrier-resilience", "jobs-resilience", "secrets-keys", "redaction", "resilience-deps", "query-plan", "migrations", "observability", "compose-up", "image-assertions", "trivy", "headers", "e2e-chromium", "e2e-firefox", "e2e-webkit", "e2e-a11y", "e2e-i18n", "e2e-security", "log-scan", "lighthouse", "k6-smoke", "k6-load", "k6-audit-ab", "k6-abuse", "scale-test", "zap-baseline", "ac-trace"],
      "e2e_scope": "@critical journeys in en on 6 projects; es and fr on chromium-mobile and chromium-desktop"
    },
    "gate": {
      "description": "Everything in wave plus the gate-only suites and the full demo matrix.",
      "always": ["unit", "integration", "catalog-c1-c14", "rls-cross-tenant", "rbac-matrix", "audit-generator", "audit-immutability", "audit-chain", "abuse", "api", "identity-session", "csrf-cookie", "rate-limit", "idempotency", "ssrf", "payments-webhooks", "saga-fault-matrix", "carrier-resilience", "jobs-resilience", "secrets-keys", "redaction", "resilience-deps", "query-plan", "migrations", "observability", "compose-up", "image-assertions", "trivy", "headers", "e2e-chromium", "e2e-firefox", "e2e-webkit", "e2e-a11y", "e2e-i18n", "e2e-security", "log-scan", "lighthouse", "k6-smoke", "k6-load", "k6-audit-ab", "k6-abuse", "scale-test", "zap-baseline", "ac-trace", "k6-soak", "stryker", "restore-rehearsal", "valkey-compat", "gitleaks-full", "flake-report"],
      "e2e_scope": "all journeys of e2e-journeys.md; J-M1-01 x 3 carriers x 3 locales x 6 projects; keyboard-only J-KB-* on 3 engines desktop"
    }
  },
  "path_rules": [
    {
      "id": "backend",
      "globs": ["apps/api/**", "apps/worker/**", "packages/**", "!packages/ui/**", "prisma/**"],
      "profile_min": "pr",
      "suites": ["integration", "api", "rbac-matrix", "audit-generator", "audit-immutability", "rls-cross-tenant", "catalog-c1-c14", "abuse", "csrf-cookie", "idempotency", "ssrf", "identity-session", "rate-limit", "redaction", "secrets-keys"]
    },
    {
      "id": "money-and-carriers",
      "globs": ["apps/api/src/modules/orders/**", "apps/api/src/modules/payments/**", "apps/api/src/modules/shipments/**", "apps/api/src/modules/pickups/**", "apps/api/src/modules/quotes/**", "apps/api/src/modules/carriers/**", "packages/carriers/**"],
      "profile_min": "pr",
      "suites": ["saga-fault-matrix", "payments-webhooks", "carrier-resilience"]
    },
    {
      "id": "jobs-and-platform",
      "globs": ["apps/worker/**", "apps/api/src/platform/**", "packages/shared/src/queues/**"],
      "profile_min": "pr",
      "suites": ["jobs-resilience", "resilience-deps", "observability"]
    },
    {
      "id": "audit-package",
      "globs": ["packages/audit/**", "apps/api/src/modules/audit/**"],
      "profile_min": "pr",
      "suites": ["audit-chain", "k6-smoke"]
    },
    {
      "id": "migrations",
      "globs": ["prisma/migrations/**", "prisma/bootstrap/**", "prisma/schema.prisma"],
      "profile_min": "pr",
      "suites": ["migrations", "query-plan"],
      "conditional": [{ "when": "a migration file contains the marker '-- @data-changing'", "add": ["restore-rehearsal"] }]
    },
    {
      "id": "repositories",
      "globs": ["apps/api/src/modules/*/repository/**"],
      "profile_min": "pr",
      "suites": ["query-plan"]
    },
    {
      "id": "frontend",
      "globs": ["apps/web/**", "apps/admin/**", "packages/ui/**"],
      "profile_min": "pr",
      "suites": ["e2e-chromium", "log-scan"],
      "e2e_scope": "@critical on chromium-mobile and chromium-desktop with axe, CSP, header and console listeners"
    },
    {
      "id": "public-web",
      "globs": ["apps/web/app/routes/**", "apps/web/react-router.config.ts", "apps/web/public/**", "infra/compose/web/**"],
      "profile_min": "pr",
      "suites": ["lighthouse", "headers"],
      "note": "Narrowed to the public pre-rendered route folder once the web scaffold fixes its path (T-QA-01)."
    },
    {
      "id": "locales",
      "globs": ["**/locales/**", "**/i18n/**", "apps/api/src/modules/notifications/templates/**"],
      "profile_min": "pr",
      "suites": ["e2e-i18n"]
    },
    {
      "id": "edge-and-headers",
      "globs": ["infra/compose/edge/**", "**/nginx*.conf", "apps/api/src/platform/http/**"],
      "profile_min": "pr",
      "suites": ["headers", "e2e-security"]
    },
    {
      "id": "images-and-deps",
      "globs": ["**/Dockerfile*", "compose*.yaml", "infra/compose/**", "package-lock.json", ".npmrc"],
      "profile_min": "pr",
      "suites": ["compose-up", "image-assertions", "trivy"]
    },
    {
      "id": "perf-sensitive",
      "globs": ["packages/pricing/**", "packages/audit/**", "packages/authz/**", "tests/load/**"],
      "profile_min": "pr",
      "suites": ["k6-smoke"],
      "also_when": "the task is tagged perf in docs/04-plan"
    },
    {
      "id": "docs-or-ci-only",
      "globs": ["docs/**", ".github/**"],
      "exclude": ["docs/03-architecture/api/**", "docs/05-quality/tests/gherkin-test-map.md", "docs/01-requirements/stories/**", "docs/02-ux/design-system/**"],
      "profile_min": "none",
      "suites": [],
      "note": "Lane A only. .github/** is security-critical (SEC-P3-31): security-analyst review in the DoD."
    }
  ]
}
