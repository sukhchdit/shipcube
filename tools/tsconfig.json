{
  "extends": "../tsconfig.base.json",
  "//": "Repository tooling plus the cross-cutting Prisma test code (prisma/tests: harness, bootstrap and migration suites), which imports tools/db, the generated client and the runtime client factory (TASK-003).",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "tsBuildInfoFile": "../node_modules/.cache/tools.tsbuildinfo"
  },
  "files": [
    "../jest.config.ts",
    "../prisma.config.ts",
    "../prisma/tests/fixtures/updown/prisma.config.ts",
    "../prisma/tests/fixtures/updown-broken/prisma.config.ts",
    "../prisma/tests/fixtures/concurrent-index/prisma.config.ts",
    "../prisma/tests/fixtures/concurrent-index-multi/prisma.config.ts",
    "../prisma/tests/fixtures/concurrent-index-partial/prisma.config.ts",
    "../apps/api/src/platform/db/client.ts",
    "../apps/api/src/platform/db/expect-affected.ts",
    "../apps/api/src/platform/db/map-db-error.ts",
    "../apps/api/src/platform/db/tenant-db.ts",
    "../apps/api/src/platform/db/with-tenant-tx.ts"
  ],
  "include": ["**/*.ts", "**/*.mjs", "../prisma/tests/**/*.ts", "../prisma/generated/**/*.ts"],
  "exclude": ["**/fixtures/**", "../prisma/tests/fixtures/**"],
  "references": [{ "path": "../packages/authz" }]
}
