    "../prisma/tests/fixtures/updown-broken/prisma.config.ts",
    "../prisma/tests/fixtures/concurrent-index/prisma.config.ts",
    "../prisma/tests/fixtures/concurrent-index-multi/prisma.config.ts",
    "../prisma/tests/fixtures/concurrent-index-partial/prisma.config.ts",
    "../apps/api/src/platform/db/client.ts",
    "../apps/api/src/platform/db/dedicated-connection.ts",
    "../apps/api/src/platform/db/expect-affected.ts",
    "../apps/api/src/platform/db/extensions/standard-columns.ts",
    "../apps/api/src/platform/db/health-check.ts",
    "../apps/api/src/platform/db/index.ts",
    "../apps/api/src/platform/db/map-db-error.ts",
    "../apps/api/src/platform/db/runtime.ts",
    "../apps/api/src/platform/db/session-integrity.ts",
    "../apps/api/src/platform/db/system-db.ts",
    "../apps/api/src/platform/db/system-models.ts",
    "../apps/api/src/platform/db/system-port.ts",
    "../apps/api/src/platform/db/tenant-db.ts",
    "../apps/api/src/platform/db/with-tenant-tx.ts",
    "../apps/api/src/platform/health/checks/audit-chain.ts",
    "../apps/api/src/platform/health/checks/audit-partitions.ts",
    "../apps/api/src/platform/health/checks/catalog-reader.ts",
    "../apps/api/src/platform/runtime/log.ts",
    "../apps/api/src/platform/runtime/readiness.ts",
    "../apps/api/src/platform/runtime/shutdown.ts"
  ],
  "include": ["**/*.ts", "**/*.mjs", "../prisma/tests/**/*.ts", "../prisma/seed/**/*.ts", "../prisma/generated/**/*.ts"],
  "exclude": ["**/fixtures/**", "../prisma/tests/fixtures/**"],
  "references": [{ "path": "../packages/authz" }]
}
