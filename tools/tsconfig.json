{
  "extends": "../tsconfig.base.json",
  "//": "Repository tooling plus the cross-cutting Prisma test code (prisma/tests: harness, bootstrap, migration and seed suites) and the seed framework those suites import (prisma/seed), which imports tools/db, the generated client and the runtime client factory (TASK-003).",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
