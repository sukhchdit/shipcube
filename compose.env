# LOCAL-ONLY configuration for `docker compose up` (platform.md §1, D-022). NOT SECRET, NOT FOR ANY SHARED ENVIRONMENT.
#
# Every credential and key below is a visible local-only-* marker, not a real secret. packages/config refuses
# every local-only-* value when APP_ENV is staging or production (SEC-P3-08 item 5, SEC-TC-51), and the key
# provider derives local key bytes from the markers in local/test only. Carrier-sandbox and Stripe test credentials
# never go here (platform.md §2.7): put them in user-scoped environment variables or the git-ignored .env.local.
# tools/config/compose-env.test.ts checks that this file loads for the API and the worker with APP_ENV=local and
# is refused with APP_ENV=staging.

NODE_ENV=development
APP_ENV=local
APP_PORT=3000
APP_HEALTH_PORT=9464
APP_LOG_LEVEL=info
DOCS_ENABLED=true
WEB_APP_ORIGIN=https://localhost:8443
ADMIN_APP_ORIGIN=https://localhost:8444
TRUST_PROXY_HOPS=1
REGION=local
LOCALE_DEFAULT=en

BRAND_NAME=Shipqube
VITE_API_BASE_URL=/api
VITE_LOCALES=en,es,fr

DATABASE_URL=postgresql://platform_app:local-only-platform-app-password@postgres:5432/platform?sslmode=disable
# DB_POOL_MAX is left to its per-service default (api 10, worker 5; data-model §7.1).
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=25000

# --- tooling only (db:bootstrap / db:reset / migrate job; never api/worker outside local) ---
# The bootstrap passwords equal the passwords in DATABASE_URL and DATABASE_MIGRATOR_URL (they create those roles).
DATABASE_MIGRATOR_URL=postgresql://platform_migrator:local-only-platform-migrator-password@postgres:5432/platform?sslmode=disable
DATABASE_BOOTSTRAP_URL=postgresql://postgres:local-only-postgres-superuser-password@postgres:5432/postgres?sslmode=disable
BOOTSTRAP_MIGRATOR_PASSWORD=local-only-platform-migrator-password
BOOTSTRAP_APP_PASSWORD=local-only-platform-app-password

# Valkey ACL user `api`; compose.yaml overrides REDIS_URL for the worker with the `worker` user (platform.md §2.2).
REDIS_URL=redis://api:local-only-valkey-api-password@redis:6379

AUTH_BCRYPT_COST=12

JWT_SIGNING_KEYS=jwt-signing-v1:local-only-jwt-signing-key
CSRF_KEY=csrf-v1:local-only-csrf-key
RECOVERY_KEY=recovery-v1:local-only-recovery-key
MFA_ENCRYPTION_KEY=mfa-v1:local-only-mfa-encryption-key
AUDIT_VAULT_KEY=vault-v1:local-only-audit-vault-key
AUDIT_INDEX_KEY=audit-index-v1:local-only-audit-index-key
AUDIT_ANCHOR_SIGNING_KEY=audit-anchor-v1:local-only-audit-anchor-signing-key
AUDIT_ANCHOR_PUBLIC_KEYS=audit-anchor-v1:local-only-audit-anchor-public-key
TRACKING_INDEX_KEY=tracking-index-v1:local-only-tracking-index-key
OUTBOX_PAYLOAD_KEY=outbox-payload-v1:local-only-outbox-payload-key
IDEMPOTENCY_BODY_KEY=idempotency-body-v1:local-only-idempotency-body-key
CURSOR_KEY=cursor-v1:local-only-cursor-key
LOGIN_COUNTER_KEY=login-counter-v1:local-only-login-counter-key
CARRIER_TOKEN_CACHE_KEY=carrier-token-cache-v1:local-only-carrier-token-cache-key
IDENTIFIER_ENCRYPTION_KEY=identifier-v1:local-only-identifier-encryption-key
AUDIT_VAULT_HMAC_KEY=vault-hmac-v1:local-only-audit-vault-hmac-key
MFA_CHALLENGE_BIND_KEY=mfa-challenge-bind-v1:local-only-mfa-challenge-bind-key
MFA_ENROLMENT_CODE_KEY=mfa-enrolment-code-v1:local-only-mfa-enrolment-code-key
MOCK_GATEWAY_WEBHOOK_SECRET=mock-gateway-webhook-v1:local-only-mock-gateway-webhook-secret

PAYMENT_PROVIDER=mock
MOCK_CARRIER_ENABLED=true
MOCK_SCENARIOS_ENABLED=true
CARRIER_TOKEN_CACHE=redis

STORAGE_ENDPOINT=http://rustfs:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true
STORAGE_BUCKET_DOCUMENTS=documents
STORAGE_BUCKET_RAW_CARRIER_PAYLOADS=raw-carrier-payloads
STORAGE_PRESIGN_TTL_SECONDS=300
STORAGE_ACCESS_KEY_ID_REF=env:STORAGE_ACCESS_KEY_ID
STORAGE_SECRET_ACCESS_KEY_REF=env:STORAGE_SECRET_ACCESS_KEY
STORAGE_ACCESS_KEY_ID=local-only-rustfs-access-key
STORAGE_SECRET_ACCESS_KEY=local-only-rustfs-secret-key

MAIL_PROVIDER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_FROM=no-reply@shipqube.local

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

AUDIT_ANCHOR_SINK=file:///data/audit-anchors/anchors.ndjson

SEED_SUPERADMIN_PASSWORD=local-only-superadmin-password
SEED_CUSTOMER_PASSWORD=local-only-customer-password
