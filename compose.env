# LOCAL-ONLY configuration for `docker compose up` (platform.md §1, D-022). NOT SECRET, NOT FOR ANY SHARED ENVIRONMENT.
#
# Every credential and key below is a visible local-only-* marker, not a real secret. packages/config refuses
# every local-only-* value when APP_ENV is staging or production (SEC-P3-08 item 5, SEC-TC-51), and the key
# provider derives local key bytes from the markers in local/test only. Carrier-sandbox and Stripe test credentials
# never go here (platform.md §2.7): put them in user-scoped environment variables or the git-ignored .env.local.
#
# TASK-014 (PR13-SEC-08/-06, PR3-SEC-06): this file is the SHARED RUNTIME BASE of the api and worker services only.
# It holds no tooling key and no key the key register gives to one service alone; those live in the per-service files
# under infra/local/env/ (api.env, worker.env, tooling.env, seed.env, bootstrap.env, postgres.env, redis.env,
# rustfs.env), and compose.yaml gives every service only the files it needs. tools/config/compose-env.test.ts checks the
# partition, that the merged api and worker environments load with APP_ENV=local and no "does not hold" warning, and
# that they are refused with APP_ENV=staging.

NODE_ENV=development
APP_ENV=local
APP_PORT=3000
APP_HEALTH_PORT=9464
APP_LOG_LEVEL=info
DOCS_ENABLED=true
WEB_APP_ORIGIN=https://localhost:8443
ADMIN_APP_ORIGIN=https://localhost:8444
TRUST_PROXY_HOPS=1
REGION=local
LOCALE_DEFAULT=en

BRAND_NAME=Shipqube
VITE_API_BASE_URL=/api
VITE_LOCALES=en,es,fr

DATABASE_URL=postgresql://platform_app:local-only-platform-app-password@postgres:5432/platform?sslmode=disable
# DB_POOL_MAX is left to its per-service default (api 10, worker 5; data-model §7.1).
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=25000

# REDIS_URL is per service (api.env / worker.env): each carries its own Valkey ACL user (platform.md §2.2).

AUTH_BCRYPT_COST=12

# Keys held by both the api and the worker (ADR-0018 key register). Single-holder keys: api.env / worker.env.
AUDIT_VAULT_KEY=vault-v1:local-only-audit-vault-key
AUDIT_INDEX_KEY=audit-index-v1:local-only-audit-index-key
AUDIT_ANCHOR_PUBLIC_KEYS=audit-anchor-v1:local-only-audit-anchor-public-key
TRACKING_INDEX_KEY=tracking-index-v1:local-only-tracking-index-key
OUTBOX_PAYLOAD_KEY=outbox-payload-v1:local-only-outbox-payload-key
CARRIER_TOKEN_CACHE_KEY=carrier-token-cache-v1:local-only-carrier-token-cache-key
IDENTIFIER_ENCRYPTION_KEY=identifier-v1:local-only-identifier-encryption-key
AUDIT_VAULT_HMAC_KEY=vault-hmac-v1:local-only-audit-vault-hmac-key

PAYMENT_PROVIDER=mock
MOCK_CARRIER_ENABLED=true
MOCK_SCENARIOS_ENABLED=true
CARRIER_TOKEN_CACHE=redis

# STORAGE_PUBLIC_ENDPOINT is the edge store vhost on 127.0.0.1:9000 (infra/local/edge/storage.conf); RustFS itself
# publishes no host port (compose.debug.yaml publishes it on 127.0.0.1:9002 for host tooling).
STORAGE_ENDPOINT=http://rustfs:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true
STORAGE_BUCKET_DOCUMENTS=documents
STORAGE_BUCKET_RAW_CARRIER_PAYLOADS=raw-carrier-payloads
STORAGE_PRESIGN_TTL_SECONDS=300
# The references resolve to the RustFS root credentials (infra/local/env/rustfs.env holds the same local-only values).
STORAGE_ACCESS_KEY_ID_REF=env:STORAGE_ACCESS_KEY_ID
STORAGE_SECRET_ACCESS_KEY_REF=env:STORAGE_SECRET_ACCESS_KEY
STORAGE_ACCESS_KEY_ID=local-only-rustfs-access-key
STORAGE_SECRET_ACCESS_KEY=local-only-rustfs-secret-key

MAIL_PROVIDER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_FROM=no-reply@shipqube.local

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

AUDIT_ANCHOR_SINK=file:///data/audit-anchors/anchors.ndjson

# Per-transaction timeouts set by withTenantTx (ms; data-model 4.1, ADR-0005 am. 10 item 12, TASK-016).
DB_TX_STATEMENT_TIMEOUT_MS=5000
DB_TX_LOCK_TIMEOUT_MS=2000
DB_TX_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
