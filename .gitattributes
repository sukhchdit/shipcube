# Normalise all text files to LF in the repo and the working tree, so shell
# scripts, Dockerfiles and config behave the same on Windows hosts and in
# Linux containers and CI.
* text=auto eol=lf

# Windows-only scripts need CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never convert or diff as text
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.zip   binary
*.gz    binary
*.xlsx  binary
*.xls   binary
*.docx  binary

# Lockfiles: generated, keep diffs readable in reviews
package-lock.json  linguist-generated=true -diff
pnpm-lock.yaml     linguist-generated=true -diff
